OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-large
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=alloy

# MongoDB — book library metadata and PDFs (GridFS). Required.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=bookchat
MONGODB_BOOKS_COLLECTION=books
MONGODB_PDF_BUCKET=pdfs
MONGODB_INGEST_PROGRESS_COLLECTION=ingest_progress
MONGODB_CHAT_SESSIONS_COLLECTION=chat_sessions
MONGODB_USERS_COLLECTION=users

# JWT (change JWT_SECRET in production)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=10080

# Seed admin (scripts/seed_admin.py)
# SEED_ADMIN_EMAIL=admin@bookchat.local
# SEED_ADMIN_PASSWORD=Admin123!

# Demo (scripts/seed_demo.py) — POST /auth/demo-login, no password
# DEMO_USER_EMAIL=demo@bookchat.local
# DEMO_BOOK_ID=harry-potter-and-the-philosopher-s-stone-openai

# Pinecone — vector embeddings. Required.
PINECONE_API_KEY=
PINECONE_INDEX=bookchat-openai-3072
PINECONE_INDEX_OPENAI=bookchat-openai-3072

# PINECONE_SERVERLESS_CLOUD=aws
# PINECONE_SERVERLESS_REGION=us-east-1

CHUNK_SIZE=900
CHUNK_OVERLAP=150

# Optional: require X-Admin-Token header for GET /admin/*
# ADMIN_API_TOKEN=change-me
